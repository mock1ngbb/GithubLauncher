{
	"version": "1",
	"owner": "mock1ngbb",
	"repo": "GithubLauncher",
	"targets": [
		{
			"service_id": "script:github-launcher:build",
			"platform": "script",
			"build": {
				"build_cmd": "dotnet publish --configuration Release --runtime osx-arm64 --self-contained true -p:IncludeNativeLibrariesForSelfExtract=true"
			},
			"artifact": {
				"type": "none"
			},
			"health_check": {
				"command": "test -x bin/Release/net9.0/osx-arm64/publish/GithubLauncher"
			},
			"rollback_strategy": "manual",
			"watch_paths": [
				"*.cs",
				"*.csproj",
				"*.sln",
				"*.axaml",
				"*.axaml.cs",
				"lib/GitHubLauncher.Core/**/*.cs",
				"lib/GitHubLauncher.Core/**/*.csproj",
				"Models/**",
				"Services/**",
				"Converters/**",
				"Assets/**"
			],
			"deploy_branch": "hee-haw",
			"destructive_gate": false,
			"max_deploy_time_seconds": 600,
			"concurrent_deploys": "serial"
		}
	],
	"secrets": [
		"GITHUB_TOKEN"
	],
	"env": {}
}
